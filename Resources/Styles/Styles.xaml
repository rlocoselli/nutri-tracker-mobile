<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ContentPage">
        <Setter Property="Background" Value="{StaticResource PageGradient}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="NavigationPage.HasNavigationBar" Value="False" />
    </Style>

    <!-- Typography -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemiBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="LineHeight" Value="1.1" />
        <Setter Property="TextColor" Value="#1F2D2A" />
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="1.1" />
        <Setter Property="TextColor" Value="#2E3C39" />
    </Style>

    <Style x:Key="BodyMuted" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="FontFamily" Value="OpenSansSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BorderColor" Value="{StaticResource PrimaryDark}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#EAF7F1" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
        <Setter Property="BorderColor" Value="#BFE3D0" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderColor" Value="{StaticResource Stroke}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontFamily" Value="OpenSansSemiBold" />
    </Style>

    <!-- Inputs -->
    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="TitleColor" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="CharacterSpacing" Value="0.2" />
    </Style>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="Stroke" Value="{StaticResource Stroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Shadow}" Offset="0,3" Radius="12" Opacity="0.14" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
