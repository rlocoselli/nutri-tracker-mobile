<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="Primary">#58CC02</Color>
    <Color x:Key="PrimaryDark">#46A302</Color>
    <Color x:Key="Accent">#1CB0F6</Color>

    <!-- Surfaces -->
    <Color x:Key="Background">#F7FFF1</Color>
    <Color x:Key="Card2">#EFFFF8</Color>
    <Color x:Key="Stroke">#D9EFCB</Color>

    <!-- Keep Card as a Color (used by BackgroundColor setters) -->
    <Color x:Key="Card">#FFFFFF</Color>
    <!-- Use these for properties that expect Brush (e.g., Border.Background) -->
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Card}" />
    <SolidColorBrush x:Key="Card2Brush" Color="{StaticResource Card2}" />

    <!-- Text -->
    <Color x:Key="Text">#253238</Color>
    <Color x:Key="Muted">#6E7E85</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>

    <!-- Decorative brushes -->
    <LinearGradientBrush x:Key="PageGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7FFF1" Offset="0.0" />
        <GradientStop Color="#E8FCE1" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7BEF21" Offset="0.0" />
        <GradientStop Color="#58CC02" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Macro colors -->
    <Color x:Key="MacroCarbs">#3B82F6</Color>
    <Color x:Key="MacroProtein">#14B89A</Color>
    <Color x:Key="MacroFat">#F59E0B</Color>

    <!-- Shadows -->
    <Color x:Key="Shadow">#20323F24</Color>

</ResourceDictionary>
