<?xml version="1.0" encoding="utf-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:NutritionTracker.Pages"
    x:Class="NutritionTracker.AppShell"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent x:Name="DashboardTab" Title="Tableau" Icon="ic_home.svg" ContentTemplate="{DataTemplate pages:DashboardPage}" Route="dashboard" />
        <ShellContent x:Name="DiaryTab" Title="Journal" Icon="ic_diary.svg" ContentTemplate="{DataTemplate pages:DiaryPage}" Route="diary" />
        <ShellContent x:Name="AddTab" Title="Ajouter" Icon="ic_add.svg" ContentTemplate="{DataTemplate pages:AddMealPage}" Route="add" />
        <ShellContent x:Name="GoalsTab" Title="Objectifs" Icon="ic_goals.svg" ContentTemplate="{DataTemplate pages:GoalsPage}" Route="goals" />
        <ShellContent x:Name="ProfileTab" Title="Profil" Icon="ic_profile.svg" ContentTemplate="{DataTemplate pages:ProfilePage}" Route="profile" />
    </TabBar>
</Shell>
