<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutritionTracker.Pages.AddMealPage"
             Title="Ajouter"
             BackgroundColor="{StaticResource Background}">

  <Grid>
    <ScrollView>
      <VerticalStackLayout Padding="20" Spacing="16">

      <Label Text="{Binding TitleText}" Style="{StaticResource H1}" />
      <Label Text="{Binding SubtitleText}" Style="{StaticResource BodyMuted}" />

      <Border Style="{StaticResource Card}">
        <Editor Text="{Binding Text}" AutoSize="TextChanges" Placeholder="{Binding EditorPlaceholder}" HeightRequest="120" />
      </Border>

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="6">
          <Label Text="{Binding MealTypeTitle}" FontAttributes="Bold" />
          <Picker ItemsSource="{Binding MealTypeOptions}"
                  ItemDisplayBinding="{Binding Label}"
                  SelectedItem="{Binding SelectedMealTypeOption}"
                  Title="{Binding MealTypeLabel}" />
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="6">
          <Label Text="{Binding StoryVisibilityTitle}" FontAttributes="Bold" />
          <Picker ItemsSource="{Binding StoryVisibilityOptions}"
                  ItemDisplayBinding="{Binding Label}"
                  SelectedItem="{Binding SelectedStoryVisibilityOption}"
                  Title="{Binding StoryVisibilityLabel}" />
        </VerticalStackLayout>
      </Border>

      <Button Text="{Binding VoiceInputText}" Style="{StaticResource SecondaryButton}" Command="{Binding VoiceInputCommand}" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Button Text="{Binding PickPhotoText}" Style="{StaticResource SecondaryButton}" Command="{Binding PickPhotoCommand}" />
        <Button Grid.Column="1" Text="{Binding CapturePhotoText}" Style="{StaticResource SecondaryButton}" Command="{Binding CapturePhotoCommand}" />
      </Grid>

      <Border Style="{StaticResource Card}" IsVisible="{Binding HasPhoto}">
        <Image Source="{Binding PhotoPath}" Aspect="AspectFill" HeightRequest="220" />
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Button Text="{Binding AnalyzeText}" Command="{Binding AnalyzeCommand}" />
        <Button Grid.Column="1" Text="{Binding ClearText}" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}" />
      </Grid>

        <Border Style="{StaticResource Card}" IsVisible="{Binding HasResult}">
          <VerticalStackLayout Spacing="6">
            <Label Text="{Binding ResultTitle}" FontAttributes="Bold" />
            <Label Text="{Binding ResultSummary}" />
            <Label Text="{Binding ResultQuality}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
            <Label Text="{Binding ResultBadge}" FontAttributes="Bold" />
            <Label Text="{Binding ResultTigerCatMood}" FontAttributes="Bold" />
            <Label Text="{Binding ResultSemaphore}" Style="{StaticResource BodyMuted}" />
            <Border Style="{StaticResource Card}" Background="{StaticResource Card2Brush}" Padding="10,8" IsVisible="{Binding HasScoreWhy}">
              <Label Text="{Binding ResultScoreWhy}" FontSize="12" LineBreakMode="WordWrap" />
            </Border>
            <Border Style="{StaticResource Card}" Background="{StaticResource Card2Brush}" Padding="10,8">
              <VerticalStackLayout Spacing="4">
                <Label Text="{Binding ResultMotivation}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                <Label Text="{Binding ResultSocialStatus}" FontSize="12" TextColor="{StaticResource Muted}" />
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Background="{StaticResource Card2Brush}" Padding="10,8" IsVisible="{Binding HasTip}">
              <VerticalStackLayout Spacing="4">
                <Label Text="{Binding ResultTipTitle}" FontAttributes="Bold" />
                <Label Text="{Binding ResultTipMessage}" />
                <Label Text="{Binding ResultTipChallenge}" FontSize="12" FontAttributes="Bold" />
                <Label Text="{Binding ResultTipProgress}" FontSize="12" TextColor="{StaticResource Muted}" />
              </VerticalStackLayout>
            </Border>
            <Label Text="{Binding ResultNotes}" FontSize="12" Opacity="0.7" />
          </VerticalStackLayout>
        </Border>

      </VerticalStackLayout>
    </ScrollView>

    <Grid IsVisible="{Binding IsBusy}"
          BackgroundColor="#80000000"
          InputTransparent="False">
      <Border Style="{StaticResource Card}"
              Padding="18"
              MaximumWidthRequest="260"
              HorizontalOptions="Center"
              VerticalOptions="Center">
        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
          <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
          <Label Text="Analyse en cours..." HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
      </Border>
    </Grid>
  </Grid>
</ContentPage>
