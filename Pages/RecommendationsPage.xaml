<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NutritionTracker.Controls"
             xmlns:local="clr-namespace:NutritionTracker.Services"
             x:Class="NutritionTracker.Pages.RecommendationsPage"
             Title="{local:Translate Key=recommendations_title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="16">

      <controls:StravaTopBar TitleText="{Binding TitleText}" />

      <Label Text="{Binding TitleText}" Style="{StaticResource H1}" />
      <Label Text="{Binding SubtitleText}" Style="{StaticResource BodyMuted}" />

      <Button Text="{Binding GenerateText}" Command="{Binding GenerateCommand}" />
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

      <Border Style="{StaticResource Card}" IsVisible="{Binding HasResult}">
        <VerticalStackLayout Spacing="10">
          <Label Text="{Binding AnalysisText}" FontAttributes="Bold" />
          <Label Text="{Binding InsightsText}" />
          <Label Text="{Binding WarningsText}" FontSize="12" TextColor="{StaticResource Muted}" />
        </VerticalStackLayout>
      </Border>

      <CollectionView ItemsSource="{Binding Items}" IsVisible="{Binding HasResult}">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <VerticalStackLayout Spacing="6">
                <Label Text="{Binding title}" FontAttributes="Bold" />
                <Label Text="{Binding why}" FontSize="12" Opacity="0.75" />
                <Label Text="{local:Translate Key=actions}" FontAttributes="Bold" FontSize="12" />
                <CollectionView ItemsSource="{Binding actions}">
                  <CollectionView.ItemTemplate>
                    <DataTemplate>
                      <Label Text="{Binding ., StringFormat='• {0}'}" />
                    </DataTemplate>
                  </CollectionView.ItemTemplate>
                </CollectionView>
              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
