<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NutritionTracker.Services"
    x:Class="NutritionTracker.Pages.GoalsPage"
    Title="{local:Translate Key=goals_title}"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{local:Translate Key=goals_title}" Style="{StaticResource H1}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="6">
                        <Label Text="{local:Translate Key=goal_cal_day}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding CaloriesTargetDisplay}" TextColor="{StaticResource Muted}" />
                    </Grid>
                    <Slider Minimum="1200" Maximum="4500" Value="{Binding CaloriesTarget}" />
                    <ProgressBar Progress="{Binding CaloriesProgress}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="6">
                        <Label Text="{local:Translate Key=goal_protein_day}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding ProteinGTargetDisplay}" TextColor="{StaticResource Muted}" />
                    </Grid>
                    <Slider Minimum="40" Maximum="260" Value="{Binding ProteinGTarget}" />
                    <ProgressBar Progress="{Binding ProteinProgress}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="6">
                        <Label Text="{local:Translate Key=goal_carbs_day}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding CarbsGTargetDisplay}" TextColor="{StaticResource Muted}" />
                    </Grid>
                    <Slider Minimum="60" Maximum="500" Value="{Binding CarbsGTarget}" />
                    <ProgressBar Progress="{Binding CarbsProgress}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{local:Translate Key=save}" Command="{Binding SaveCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
