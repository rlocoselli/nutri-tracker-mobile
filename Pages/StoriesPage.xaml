<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutritionTracker.Pages.StoriesPage"
    x:Name="StoriesRoot"
    Title="{Binding PageTitle}"
    BackgroundColor="{StaticResource Background}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="14">
                <Label Text="{Binding HeaderTitle}" Style="{StaticResource H1}" />
                <Label Text="{Binding HeaderSubtitle}" Style="{StaticResource BodyMuted}" />

                <Button Text="{Binding RefreshText}" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />

                <Label Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Style="{StaticResource BodyMuted}" />

                <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" IsVisible="{Binding HasItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17">
                                            <Image Source="{Binding AvatarSource}" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="{Binding Author}" FontAttributes="Bold" />
                                            <Label Text="{Binding PostedAtText}" FontSize="11" TextColor="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding QualityText}" FontSize="11" TextColor="{StaticResource Primary}" />
                                    </Grid>

                                    <Image Source="{Binding PhotoSource}" Aspect="AspectFill" HeightRequest="220" IsVisible="{Binding HasPhoto}" />

                                    <Label Text="{Binding Caption}" FontAttributes="Bold" />
                                    <Label Text="{Binding NutritionText}" />

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0"
                                                Text="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.LikeText}"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.ToggleLikeCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1"
                                                Text="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.MessageText}"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.SendMessageCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <Label Text="{Binding LikeCount, StringFormat='❤️ {0}'}" FontSize="11" TextColor="{StaticResource Muted}" />
                                    <Label Text="{Binding CommentCount, StringFormat='💬 {0}'}" FontSize="11" TextColor="{StaticResource Muted}" />

                                    <VerticalStackLayout Spacing="2" Margin="0,4,0,0" BindableLayout.ItemsSource="{Binding Comments}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Label LineBreakMode="TailTruncation" MaxLines="2">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding AuthorName}" FontAttributes="Bold" />
                                                            <Span Text="  " />
                                                            <Span Text="{Binding Text}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Entry Text="{Binding CommentDraft}"
                                               Placeholder="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.CommentPlaceholder}" />
                                        <Button Grid.Column="1"
                                            Text="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.SendText}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.AddCommentCommand}"
                                            CommandParameter="{Binding .}" />
                                        </Grid>

                                        <Button Text="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.ViewAllCommentsText}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.ViewCommentsCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#70000000" InputTransparent="False">
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
