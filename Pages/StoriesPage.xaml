<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutritionTracker.Pages.StoriesPage"
    x:Name="StoriesRoot"
    Title="{Binding PageTitle}"
    BackgroundColor="{StaticResource Background}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding HeaderTitle}" Style="{StaticResource H1}" />
                        <Label Text="{Binding HeaderSubtitle}" Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="↻" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Style="{StaticResource Card}" Padding="10,8">
                        <Entry Text="{Binding SearchQuery}" Placeholder="{Binding SearchPlaceholder}" ClearButtonVisibility="WhileEditing" />
                    </Border>
                    <Button Grid.Column="1"
                            Text="{Binding ClearFilterText}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearFilterCommand}"
                            IsVisible="{Binding HasActiveAuthorFilter}" />
                </Grid>

                <CollectionView ItemsSource="{Binding StoryBubbles}" SelectionMode="None" ItemsLayout="HorizontalList" IsVisible="{Binding HasBubbles}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="4" Margin="0,0,12,0" WidthRequest="74">
                                <Border WidthRequest="62" HeightRequest="62" StrokeShape="RoundRectangle 31">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.SelectBubbleCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Image Source="{Binding AvatarSource}" Aspect="AspectFill" />
                                </Border>
                                <Label Text="{Binding Author}" FontSize="11" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label Text="●" FontSize="10" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" IsVisible="{Binding IsActive}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Style="{StaticResource BodyMuted}" />

                <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" IsVisible="{Binding HasItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17">
                                            <Image Source="{Binding AvatarSource}" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="{Binding Author}" FontAttributes="Bold" />
                                            <Label Text="{Binding PostedAtText}" FontSize="11" TextColor="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding QualityText}" FontSize="11" TextColor="{StaticResource Primary}" />
                                    </Grid>

                                    <Image Source="{Binding PhotoSource}" Aspect="AspectFill" HeightRequest="220" IsVisible="{Binding HasPhoto}" />

                                    <Label Text="{Binding Caption}" FontAttributes="Bold" />
                                    <Label Text="{Binding NutritionText}" />

                                    <Grid ColumnDefinitions="*" ColumnSpacing="8">
                                        <Button Grid.Column="0"
                                                Text="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.LikeText}"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.ToggleLikeCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                        <Label Text="{Binding LikeCount, StringFormat='❤️ {0}'}" FontSize="11" TextColor="{StaticResource Muted}" />
                                        <Label Grid.Column="1" Text="{Binding CommentCount, StringFormat='💬 {0}'}" FontSize="11" TextColor="{StaticResource Muted}" />
                                    </Grid>

                                    <VerticalStackLayout Spacing="2" Margin="0,4,0,0" BindableLayout.ItemsSource="{Binding Comments}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Border WidthRequest="22" HeightRequest="22" StrokeShape="RoundRectangle 11" StrokeThickness="0">
                                                        <Image Source="{Binding AvatarSource}" Aspect="AspectFill" />
                                                    </Border>
                                                    <Label Grid.Column="1" LineBreakMode="TailTruncation" MaxLines="2" VerticalTextAlignment="Center">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding AuthorName}" FontAttributes="Bold" />
                                                                <Span Text="  " />
                                                                <Span Text="{Binding Text}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Entry Text="{Binding CommentDraft}"
                                               Placeholder="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.CommentPlaceholder}" />
                                        <Button Grid.Column="1"
                                            Text="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.SendText}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.AddCommentCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid>

                                    <Button Text="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.ViewAllCommentsText}"
                                            IsVisible="{Binding HasMoreComments}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding Source={x:Reference StoriesRoot}, Path=BindingContext.ViewCommentsCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#70000000" InputTransparent="False">
            <Border Style="{StaticResource Card}" Padding="18" MaximumWidthRequest="240" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
                    <Label Text="{Binding LoadingText}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
