<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutritionTracker.Pages.DashboardPage"
    Title="{Binding DailySummaryText}"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="{Binding DailySummaryText}" Style="{StaticResource H1}" />
            <Label Text="{Binding TodayOnlyHintText}" Style="{StaticResource BodyMuted}" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding CaloriesLabelText}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding TodayCaloriesText}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding ProteinLabelText}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding TodayProteinText}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding CarbsLabelText}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding TodayCarbsText}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding StepsLabelText}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding TodayStepsText}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding BurnLabelText}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding TodayBurnText}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Background="{StaticResource Card2Brush}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding NetLabelText}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding TodayNetCaloriesText}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="{Binding FitSyncStatusText}" IsVisible="{Binding ShowGoogleFitUi}" FontSize="12" TextColor="{StaticResource Muted}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
