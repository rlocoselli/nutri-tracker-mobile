<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:NutritionTracker.Controls"
    x:Class="NutritionTracker.Pages.DashboardPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Background}">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,20" Spacing="12">
            <controls:StravaTopBar TitleText="{Binding HomeTitleText}" />

            <Label Text="{Binding TodayOnlyHintText}" Style="{StaticResource BodyMuted}" />

            <Label Text="{Binding KpiSectionTitle}" FontAttributes="Bold" FontSize="12" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding CaloriesLabelText}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding TodayCaloriesText}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding ProteinLabelText}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding TodayProteinText}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding CarbsLabelText}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding TodayCarbsText}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Background="{StaticResource Card2Brush}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding NetLabelText}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding TodayNetCaloriesText}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Background="{StaticResource Card2Brush}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding GamificationTitleText}" FontAttributes="Bold" FontSize="12" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding GamificationScoreLabelText}" Style="{StaticResource BodyMuted}" />
                            <Label Text="{Binding GamificationScoreText}" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding GamificationLevelLabelText}" Style="{StaticResource BodyMuted}" />
                            <Label Text="{Binding GamificationLevelText}" FontAttributes="Bold" FontSize="18" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding MacroChartTitle}" FontAttributes="Bold" FontSize="12" />
                    <controls:MacroDonutChart HeightRequest="180"
                                              Values="{Binding MacroChartValues}"
                                              Labels="{Binding MacroChartLabels}" />

                    <Label Text="{Binding MacroLegendTitle}" Style="{StaticResource BodyMuted}" />
                    <HorizontalStackLayout Spacing="16">
                        <HorizontalStackLayout Spacing="6">
                            <Border WidthRequest="10" HeightRequest="10" BackgroundColor="{StaticResource MacroProtein}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Center" />
                            <Label Text="{Binding ProteinLabelText}" FontSize="12" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="6">
                            <Border WidthRequest="10" HeightRequest="10" BackgroundColor="{StaticResource MacroCarbs}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Center" />
                            <Label Text="{Binding CarbsLabelText}" FontSize="12" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="6">
                            <Border WidthRequest="10" HeightRequest="10" BackgroundColor="{StaticResource MacroFat}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Center" />
                            <Label Text="{Binding FatLabelText}" FontSize="12" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding GoalChartTitle}" FontAttributes="Bold" FontSize="12" />
                    <controls:BarChart HeightRequest="200"
                                       Values="{Binding GoalChartValues}"
                                       Labels="{Binding GoalChartLabels}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding StreakTitleText, StringFormat='★ {0}'}" FontAttributes="Bold" FontSize="12" />
                    <Label Text="{Binding StreakSubtitleText}" Style="{StaticResource BodyMuted}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding StreakText}" FontSize="20" FontAttributes="Bold" />
                            <Label Text="{Binding BalanceStatusText}" Style="{StaticResource BodyMuted}" />
                            <Label Text="{Binding StreakHintText}" Style="{StaticResource BodyMuted}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="i"
                                ImageSource="ic_help.svg"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ShowBalanceInfoCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding RecordingStreakTitleText, StringFormat='✦ {0}'}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding RecordingStreakText}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding CoinsTitleText, StringFormat='◎ {0}'}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding CoinsText, StringFormat='◎ {0}'}" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Background="{StaticResource Card2Brush}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding WeeklyMissionTitleText, StringFormat='🚀 {0}'}" FontAttributes="Bold" FontSize="12" />
                    <Label Text="{Binding WeeklyMissionStatusText}" Style="{StaticResource BodyMuted}" />

                    <CollectionView ItemsSource="{Binding WeeklyMissions}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,2">
                                    <Label Text="✅" IsVisible="{Binding IsCompleted}" />
                                    <Label Text="🎯" IsVisible="False">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="False">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="12" />
                                        <Label Text="{Binding Hint}" Style="{StaticResource BodyMuted}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding ProgressText}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding FitSyncStatusText}" IsVisible="{Binding ShowGoogleFitUi}" FontSize="12" TextColor="{StaticResource Muted}" />
        </VerticalStackLayout>
    </ScrollView>

    <Grid IsVisible="{Binding IsLoading}" BackgroundColor="#40000000" InputTransparent="True">
        <Border Style="{StaticResource Card}" Padding="18" MaximumWidthRequest="240" HorizontalOptions="Center" VerticalOptions="Center">
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
                <Label Text="{Binding LoadingText}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
    </Grid>
</ContentPage>
