<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:NutritionTracker.Controls"
    x:Class="NutritionTracker.Pages.DiaryPage"
    x:Name="DiaryRoot"
    Title="Journal"
    BackgroundColor="{StaticResource Background}">

    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="14">

        <!-- Day navigation -->
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
            <Button Text="‹" Style="{StaticResource IconButton}" FontSize="22"
                    Command="{Binding PrevDayCommand}" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <Label Text="{Binding SelectedDayText}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" />
                <Label Text="{Binding DayTotalsText}" FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="›" Style="{StaticResource IconButton}" FontSize="22"
                    Command="{Binding NextDayCommand}" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding DayTabs}" SelectionMode="None" HeightRequest="48">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="10,6">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Card2Brush}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Label}" FontSize="12" FontAttributes="Bold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference DiaryRoot}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Chart -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding MetricTitle}" FontAttributes="Bold" FontSize="12" />
                <CollectionView ItemsSource="{Binding MetricTabs}" SelectionMode="None" HeightRequest="46">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="10,6">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Card2Brush}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Label}" FontSize="12" FontAttributes="Bold" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference DiaryRoot}, Path=BindingContext.SelectMetricTabCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding PeriodTitle}" FontAttributes="Bold" FontSize="12" />
                <CollectionView ItemsSource="{Binding PeriodTabs}" SelectionMode="None" HeightRequest="46">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="10,6">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Card2Brush}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Label}" FontSize="12" FontAttributes="Bold" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference DiaryRoot}, Path=BindingContext.SelectPeriodTabCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <controls:TrendChart HeightRequest="210"
                                     Values="{Binding ChartValues}"
                                     Labels="{Binding ChartLabels}" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Background="{StaticResource Card2Brush}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding HydrationTitle}" FontAttributes="Bold" />
                <Label Text="{Binding WaterLitersText}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                <CollectionView ItemsSource="{Binding WaterBottleImages}" SelectionMode="None" HeightRequest="98">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding .}" HeightRequest="90" WidthRequest="34" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                    <Button Text="{Binding AddHalfLiterText}" Style="{StaticResource SecondaryButton}" Command="{Binding AddHalfLiterCommand}" />
                    <Button Grid.Column="1" Text="{Binding AddOneLiterText}" Style="{StaticResource SecondaryButton}" Command="{Binding AddOneLiterCommand}" />
                    <Button Grid.Column="2" Text="{Binding RemoveHalfLiterText}" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveHalfLiterCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
            <Label Text="{Binding MealsTitle}" Style="{StaticResource H1}" />
            <Button Grid.Column="1" Text="{Binding AddManualText}" Style="{StaticResource SecondaryButton}" Command="{Binding AddManualCommand}" />
            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding MealsSubtitle}" Style="{StaticResource BodyMuted}" />
        </Grid>

        <CollectionView Grid.Row="5" ItemsSource="{Binding Meals}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                            <Label Grid.Column="1" Text="{Binding CaloriesText}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding Subtitle}" TextColor="{StaticResource Muted}" FontSize="12" />
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="10" HorizontalOptions="End">
                                <Label Text="{Binding ProteinText}" TextColor="{StaticResource MacroProtein}" FontSize="12" />
                                <Label Text="{Binding CarbsText}" TextColor="{StaticResource MacroCarbs}" FontSize="12" />
                            </HorizontalStackLayout>
                            <Label Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding DescriptionText}"
                                   IsVisible="{Binding HasDescription}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"
                                   Style="{StaticResource BodyMuted}" />
                            <Label Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Text="{Binding AnalysisText}"
                                IsVisible="{Binding HasAnalysis}"
                                LineBreakMode="WordWrap"
                                MaxLines="3"
                                FontSize="12"
                                TextColor="{StaticResource Primary}" />
                            <Label Grid.Row="4"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding QualityBadgeText}"
                                   IsVisible="{Binding HasQualityBadge}"
                                   FontAttributes="Bold"
                                   FontSize="12" />
                            <Label Grid.Row="5"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding QualitySemaphoreText}"
                                   IsVisible="{Binding HasQualitySemaphore}"
                                   Style="{StaticResource BodyMuted}" />
                            <HorizontalStackLayout Grid.Row="6" Grid.ColumnSpan="2" Spacing="8" HorizontalOptions="End">
                                <Button Style="{StaticResource SecondaryButton}"
                                    Text="{Binding Source={x:Reference DiaryRoot}, Path=BindingContext.EditText}"
                                        Command="{Binding Source={x:Reference DiaryRoot}, Path=BindingContext.EditMealCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Text="{Binding Source={x:Reference DiaryRoot}, Path=BindingContext.DeleteText}"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={x:Reference DiaryRoot}, Path=BindingContext.DeleteMealCommand}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid IsVisible="{Binding IsManualPopupVisible}"
              BackgroundColor="#80000000"
              InputTransparent="False"
              Grid.RowSpan="5">
            <Border Style="{StaticResource Card}"
                    MaximumWidthRequest="460"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding ManualPopupTitle}" Style="{StaticResource H1}" />

                    <Label Text="{Binding ManualMealLabel}" FontAttributes="Bold" FontSize="12" />
                    <Entry Text="{Binding ManualMealName}" Placeholder="{Binding ManualMealPlaceholder}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding CaloriesLabel}" FontAttributes="Bold" FontSize="12" />
                            <Entry Text="{Binding ManualCalories}" Keyboard="Numeric" Placeholder="{Binding CaloriesPlaceholder}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding ProteinLabel}" FontAttributes="Bold" FontSize="12" />
                            <Entry Text="{Binding ManualProtein}" Keyboard="Numeric" Placeholder="{Binding ProteinPlaceholder}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding CarbsLabel}" FontAttributes="Bold" FontSize="12" />
                    <Entry Text="{Binding ManualCarbs}" Keyboard="Numeric" Placeholder="{Binding CarbsPlaceholder}" />

                    <Label Text="{Binding MinutesLabel}" FontAttributes="Bold" FontSize="12" />
                    <Entry Text="{Binding ManualExerciseMinutes}" Keyboard="Numeric" Placeholder="{Binding MinutesPlaceholder}" />

                    <Label Text="{Binding ManualBurnPreviewText}" Style="{StaticResource BodyMuted}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="{Binding SaveText}" Command="{Binding SaveManualPopupCommand}" />
                        <Button Grid.Column="1" Text="{Binding CancelText}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseManualPopupCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsEditPopupVisible}"
              BackgroundColor="#80000000"
              InputTransparent="False"
              Grid.RowSpan="5">
            <Border Style="{StaticResource Card}"
                    MaximumWidthRequest="460"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding EditPopupTitle}" Style="{StaticResource H1}" />

                    <Label Text="{Binding ManualMealLabel}" FontAttributes="Bold" FontSize="12" />
                    <Entry Text="{Binding EditMealName}" Placeholder="{Binding ManualMealPlaceholder}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding CaloriesLabel}" FontAttributes="Bold" FontSize="12" />
                            <Entry Text="{Binding EditCalories}" Keyboard="Numeric" Placeholder="{Binding CaloriesPlaceholder}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding ProteinLabel}" FontAttributes="Bold" FontSize="12" />
                            <Entry Text="{Binding EditProtein}" Keyboard="Numeric" Placeholder="{Binding ProteinPlaceholder}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding CarbsLabel}" FontAttributes="Bold" FontSize="12" />
                    <Entry Text="{Binding EditCarbs}" Keyboard="Numeric" Placeholder="{Binding CarbsPlaceholder}" />

                    <Border Style="{StaticResource Card}" Background="{StaticResource Card2Brush}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding EditQualityPreviewText}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding EditBadgePreviewText}" FontAttributes="Bold" />
                            <Label Text="{Binding EditSemaphorePreviewText}" Style="{StaticResource BodyMuted}" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="{Binding SaveText}" Command="{Binding SaveEditPopupCommand}" />
                        <Button Grid.Column="1" Text="{Binding CancelText}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseEditPopupCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
