<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:NutritionTracker.Controls"
    x:Class="NutritionTracker.Pages.DiaryPage"
    Title="Journal"
    BackgroundColor="{StaticResource Background}">

    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">

        <!-- Day navigation -->
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
            <Button Text="‹" Style="{StaticResource IconButton}" FontSize="22"
                    Command="{Binding PrevDayCommand}" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <Label Text="{Binding SelectedDayText}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" />
                <Label Text="{Binding DayTotalsText}" FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="›" Style="{StaticResource IconButton}" FontSize="22"
                    Command="{Binding NextDayCommand}" />
        </Grid>

        <!-- Chart -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Picker Title="Métrique" ItemsSource="{Binding MetricOptions}" SelectedItem="{Binding SelectedMetric}" />
                    <Picker Grid.Column="1" Title="Période" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" />
                </Grid>
                <controls:TrendChart HeightRequest="170"
                                     Values="{Binding ChartValues}"
                                     Labels="{Binding ChartLabels}" />
            </VerticalStackLayout>
        </Border>

        <Label Grid.Row="2" Text="Vos repas" Style="{StaticResource H1}" />
        <Label Grid.Row="2" Margin="0,34,0,0" Text="Détails du jour sélectionné" Style="{StaticResource BodyMuted}" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Meals}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                            <Label Grid.Column="1" Text="{Binding CaloriesText}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding Subtitle}" TextColor="{StaticResource Muted}" FontSize="12" />
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="10" HorizontalOptions="End">
                                <Label Text="{Binding ProteinText}" TextColor="{StaticResource MacroProtein}" FontSize="12" />
                                <Label Text="{Binding CarbsText}" TextColor="{StaticResource MacroCarbs}" FontSize="12" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
