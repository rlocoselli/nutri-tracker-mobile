<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:NutritionTracker.Services" x:Class="NutritionTracker.Pages.PlanPage" Title="{local:Translate Key=plan_title}" Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource Background}">
 <ScrollView><VerticalStackLayout Padding="20" Spacing="16">
  <Label Text="{Binding Title}" Style="{StaticResource H1}"/><Label Text="{Binding Subtitle}" Style="{StaticResource BodyMuted}"/>
  <Border Style="{StaticResource Card}" Background="{StaticResource Card2Brush}"><Grid ColumnDefinitions="*,105" ColumnSpacing="8"><VerticalStackLayout Spacing="8"><Label Text="{Binding CalorieSummary}" FontAttributes="Bold"/><Label Text="{Binding ProjectionTitle}" Style="{StaticResource H2}"/><Label Text="{Binding ProjectionText}"/><Label Text="{Binding EstimateText}" Style="{StaticResource BodyMuted}" FontSize="11"/></VerticalStackLayout><Image Grid.Column="1" Source="weekly_plan_hero.png" Aspect="AspectFit" HeightRequest="105" WidthRequest="105" AutomationProperties.Name="Weekly nutrition and exercise plan"/></Grid></Border>
  <Border Style="{StaticResource Card}" Background="{StaticResource Card2Brush}"><Grid ColumnDefinitions="*,72" ColumnSpacing="8"><VerticalStackLayout Spacing="3"><Label Text="{Binding ExercisesTitle}" Style="{StaticResource H2}"/><Label Text="{Binding Subtitle}" Style="{StaticResource BodyMuted}" FontSize="11"/></VerticalStackLayout><Image Grid.Column="1" Source="tigrou_walk.png" Aspect="AspectFit" HeightRequest="72" AutomationProperties.Name="Tigrou walking with a water bottle"/></Grid></Border>
  <Image Source="exercise_movements.png" HeightRequest="230" Aspect="AspectFit" AutomationProperties.Name="Illustrated squat, mobility stretch and dumbbell press movements"/>
  <CollectionView ItemsSource="{Binding Exercises}"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><VerticalStackLayout Spacing="4"><Label Text="{Binding Name}" FontAttributes="Bold"/><Label Text="{Binding Detail}"/><Label Text="{Binding Benefit}" Style="{StaticResource BodyMuted}"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <Label Text="{Binding RecipesTitle}" Style="{StaticResource H2}"/>
  <CollectionView ItemsSource="{Binding Recipes}"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid ColumnDefinitions="70,*" ColumnSpacing="12"><Label Text="{Binding Day}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="{Binding Meal}" FontAttributes="Bold"/><Label Text="{Binding Ingredients}" FontSize="12"/><Label Text="{Binding Calories, StringFormat='{0} kcal estimées'}" Style="{StaticResource BodyMuted}"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <Button Text="{Binding RefreshText}" Command="{Binding LoadCommand}"/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
