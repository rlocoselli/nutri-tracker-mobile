<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:NutritionTracker.Services" x:Class="NutritionTracker.Pages.PlanPage" Title="{local:Translate Key=plan_title}" Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource Background}">
 <ScrollView><VerticalStackLayout Padding="20,12,20,28" Spacing="18">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout Spacing="3" VerticalOptions="Center"><Label Text="{Binding Title}" Style="{StaticResource H1}"/><Label Text="{Binding Subtitle}" Style="{StaticResource BodyMuted}" LineBreakMode="WordWrap"/></VerticalStackLayout><Image Grid.Column="1" Source="weekly_plan_hero.png" WidthRequest="92" HeightRequest="92" Aspect="AspectFit" AutomationProperties.Name="Weekly nutrition plan"/></Grid>
  <Border Style="{StaticResource Card}" Background="{StaticResource Card2Brush}"><VerticalStackLayout Spacing="11"><Label Text="{Binding ConsumptionTitle}" Style="{StaticResource H2}"/><Label Text="{Binding ProfileHint}" Style="{StaticResource BodyMuted}"/><ProgressBar Progress="{Binding CalorieProgress}" ProgressColor="{StaticResource Primary}" HeightRequest="8"/><Label Text="{Binding CalorieSummary}" FontAttributes="Bold"/><BoxView HeightRequest="1" Color="{StaticResource Stroke}" Margin="0,2"/><Label Text="{Binding ProjectionTitle}" Style="{StaticResource H2}"/><Label Text="{Binding ProjectionText}" LineBreakMode="WordWrap"/><Label Text="{Binding EstimateText}" Style="{StaticResource BodyMuted}" FontSize="11"/></VerticalStackLayout></Border>
  <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="10"><Label Text="{Binding PreferencesTitle}" Style="{StaticResource H2}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto"><Picker Title="Diet" ItemsSource="{Binding DietOptions}" SelectedItem="{Binding SelectedDiet}"/><Picker Grid.Column="1" Title="Level" ItemsSource="{Binding ExerciseLevels}" SelectedItem="{Binding SelectedExerciseLevel}"/><Picker Grid.Row="1" Title="Equipment" ItemsSource="{Binding EquipmentOptions}" SelectedItem="{Binding SelectedEquipment}"/><Picker Grid.Row="1" Grid.Column="1" Title="Minutes" ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SelectedDuration}"/></Grid><Button Text="{Binding RefreshText}" Command="{Binding LoadCommand}" HeightRequest="46"/></VerticalStackLayout></Border>
  <Grid ColumnDefinitions="*,Auto"><Label Text="{Binding ExercisesTitle}" Style="{StaticResource H2}"/><Label Grid.Column="1" Text="3 sessions" Style="{StaticResource BodyMuted}" VerticalOptions="Center"/></Grid>
  <Image Source="exercise_movements.png" HeightRequest="170" Aspect="AspectFit" AutomationProperties.Name="Exercise movement illustrations"/>
  <CollectionView ItemsSource="{Binding Exercises}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><VerticalStackLayout Spacing="3"><Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"/><Label Text="{Binding Detail}" Style="{StaticResource BodyMuted}"/><Label Text="{Binding Benefit}" FontSize="12"/></VerticalStackLayout><Border Grid.Column="1" BackgroundColor="{StaticResource Card2}" StrokeThickness="0" Padding="9,5" VerticalOptions="Start"><Label Text="{Binding Minutes, StringFormat='{0} min'}" TextColor="{StaticResource PrimaryDark}" FontSize="12" FontAttributes="Bold"/></Border></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <Grid ColumnDefinitions="*,Auto"><Label Text="{Binding RecipesTitle}" Style="{StaticResource H2}"/><Label Grid.Column="1" Text="AI estimate" Style="{StaticResource BodyMuted}" VerticalOptions="Center"/></Grid><Label Text="{Binding PlannedWeekText}" Style="{StaticResource BodyMuted}"/>
  <CollectionView ItemsSource="{Binding Recipes}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14"><Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="10"><Label Text="{Binding Day}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="{Binding Meal}" FontAttributes="Bold" LineBreakMode="WordWrap"/><Label Text="{Binding Ingredients}" Style="{StaticResource BodyMuted}" FontSize="12" LineBreakMode="WordWrap"/><Label Text="{Binding Calories, StringFormat='{0} kcal estimées'}" TextColor="{StaticResource PrimaryDark}" FontSize="12"/></VerticalStackLayout><Button Grid.Column="2" Text="↻" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReplaceRecipeCommand}" CommandParameter="{Binding .}" Style="{StaticResource IconButton}" AutomationProperties.Name="Replace recipe"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <Label Text="{Binding GroceryTitle}" Style="{StaticResource H2}"/><Border Style="{StaticResource Card}" Padding="14"><CollectionView ItemsSource="{Binding GroceryItems}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Label Text="{Binding ., StringFormat='•  {0}'}" Margin="4,3"/></DataTemplate></CollectionView.ItemTemplate></CollectionView></Border><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
