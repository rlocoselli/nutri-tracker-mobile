<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NutritionTracker.Services"
             x:Class="NutritionTracker.Pages.LoginPage"
             Title="{local:Translate Key=login_title}"
             BackgroundColor="{StaticResource Background}">

  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="16">
      <Image Source="logo.svg" HeightRequest="84" WidthRequest="84" HorizontalOptions="Start" Margin="0,8,0,0" />
      <Label Text="NutritionTracker" Style="{StaticResource H1}" />
      <Label Text="{local:Translate Key=login_subtitle}" Style="{StaticResource BodyMuted}" />

      <Entry Placeholder="{local:Translate Key=login_email_placeholder}"
             Text="{Binding Email}"
             Keyboard="Email" />

      <Entry Placeholder="{local:Translate Key=login_password_placeholder}"
             Text="{Binding Password}"
             IsPassword="True" />

      <Entry Placeholder="{local:Translate Key=login_name_placeholder}"
             Text="{Binding DisplayName}" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <Button Grid.Column="0"
                Text="{local:Translate Key=login_email_button}"
          Command="{Binding LoginEmailCommand}" />
        <Button Grid.Column="1"
                Text="{local:Translate Key=login_register_button}"
          Command="{Binding RegisterEmailCommand}" />
      </Grid>

      <Button
          Text="{local:Translate Key=login_google}"
          Command="{Binding LoginGoogleCommand}"
          ImageSource="ic_google.svg"
          ContentLayout="Left,12" />

            <Entry Placeholder="{local:Translate Key=verification_code_placeholder}"
             Text="{Binding VerificationCode}"
             Keyboard="Numeric" />
            <Button Text="{local:Translate Key=verify_email_button}"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding VerifyEmailCommand}" />

                  <Button Text="{local:Translate Key=forgot_password_button}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenForgotPasswordCommand}" />

      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

      <Label Text="{local:Translate Key=login_disclaimer}" FontSize="12" TextColor="{StaticResource Muted}" Margin="0,0,0,20" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,-10,0,16">
        <Button Grid.Column="0"
          Text="{Binding TermsLinkText}"
          Command="{Binding OpenTermsCommand}"
          BackgroundColor="Transparent"
          TextColor="{StaticResource Accent}"
          FontSize="12"
          Padding="0"
          HeightRequest="34" />
        <Button Grid.Column="1"
          Text="{Binding PrivacyLinkText}"
          Command="{Binding OpenPrivacyPolicyCommand}"
          BackgroundColor="Transparent"
          TextColor="{StaticResource Accent}"
          FontSize="12"
          Padding="0"
          HeightRequest="34" />
        <Button Grid.Column="2"
          Text="{Binding RgpdLinkText}"
          Command="{Binding OpenRgpdCommand}"
          BackgroundColor="Transparent"
          TextColor="{StaticResource Accent}"
          FontSize="12"
          Padding="0"
          HeightRequest="34" />
            </Grid>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
