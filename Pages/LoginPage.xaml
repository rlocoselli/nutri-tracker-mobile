<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NutritionTracker.Services"
             x:Class="NutritionTracker.Pages.LoginPage"
             Title="{local:Translate Key=login_title}"
                                                 Shell.NavBarIsVisible="False"
                                                 NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

  <ScrollView>
    <VerticalStackLayout Padding="20,18,20,26" Spacing="14">
      <Border Style="{StaticResource Card}" Padding="16">
        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
          <Image Source="logo_green.svg" HeightRequest="74" WidthRequest="74" HorizontalOptions="Center" />
          <Label Text="NutritionTracker" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />
          <Label Text="{local:Translate Key=login_subtitle}" Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource Card}" Padding="14">
        <VerticalStackLayout Spacing="10">
          <Entry Placeholder="{local:Translate Key=login_email_placeholder}"
                 Text="{Binding Email}"
                 Keyboard="Email" />

          <Entry Placeholder="{local:Translate Key=login_password_placeholder}"
                 Text="{Binding Password}"
                 IsPassword="True" />

          <Entry Placeholder="{local:Translate Key=login_name_placeholder}"
                 Text="{Binding DisplayName}" />

          <Button Text="{local:Translate Key=login_email_button}"
                  Command="{Binding LoginEmailCommand}" />
          <Button Text="{local:Translate Key=login_register_button}"
                  Style="{StaticResource SecondaryButton}"
                  Command="{Binding RegisterEmailCommand}" />
        </VerticalStackLayout>
      </Border>

      <Button Text="{local:Translate Key=login_google}"
              Command="{Binding LoginGoogleCommand}"
              ImageSource="ic_google.svg"
              ContentLayout="Left,12" />

      <VerticalStackLayout Spacing="8">
        <Button Text="{local:Translate Key=open_activation_screen_button}"
                Style="{StaticResource SecondaryButton}"
                ImageSource="ic_help.svg"
                ContentLayout="Left,8"
                Command="{Binding OpenActivationCommand}" />
        <Button Text="{local:Translate Key=resend_activation_from_login_button}"
                Style="{StaticResource SecondaryButton}"
                ImageSource="ic_diary.svg"
                ContentLayout="Left,8"
                Command="{Binding ResendActivationFromLoginCommand}" />
        <Button Text="{local:Translate Key=forgot_password_button}"
                Style="{StaticResource SecondaryButton}"
                ImageSource="ic_help.svg"
                ContentLayout="Left,8"
                Command="{Binding OpenForgotPasswordCommand}" />
      </VerticalStackLayout>

      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

      <Label Text="{local:Translate Key=login_disclaimer}" FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
        <Button Grid.Column="0"
                Text="{Binding TermsLinkText}"
                Command="{Binding OpenTermsCommand}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Accent}"
                FontSize="12"
                Padding="0"
                HeightRequest="34" />
        <Button Grid.Column="1"
                Text="{Binding PrivacyLinkText}"
                Command="{Binding OpenPrivacyPolicyCommand}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Accent}"
                FontSize="12"
                Padding="0"
                HeightRequest="34" />
        <Button Grid.Column="2"
                Text="{Binding RgpdLinkText}"
                Command="{Binding OpenRgpdCommand}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Accent}"
                FontSize="12"
                Padding="0"
                HeightRequest="34" />
      </Grid>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
