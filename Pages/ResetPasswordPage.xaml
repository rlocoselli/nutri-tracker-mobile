<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutritionTracker.Pages.ResetPasswordPage"
             BackgroundColor="{StaticResource Background}">

  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="14">
      <Label Text="{Binding TitleText}" Style="{StaticResource H1}" />
      <Label Text="{Binding SubtitleText}" Style="{StaticResource BodyMuted}" />

      <Entry Placeholder="{Binding EmailPlaceholder}"
             Text="{Binding Email}"
             Keyboard="Email" />

      <Button Text="{Binding SendCodeText}"
              Style="{StaticResource SecondaryButton}"
              Command="{Binding SendCodeCommand}" />

      <Entry Placeholder="{Binding ResetCodePlaceholder}"
             Text="{Binding ResetCode}"
             Keyboard="Numeric" />

      <Entry Placeholder="{Binding NewPasswordPlaceholder}"
             Text="{Binding NewPassword}"
             IsPassword="True" />

      <Button Text="{Binding ApplyResetText}"
              Command="{Binding ApplyResetCommand}" />

      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <Label Text="{Binding StatusText}" Style="{StaticResource BodyMuted}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
