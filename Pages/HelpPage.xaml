<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:NutritionTracker.Controls"
    x:Class="NutritionTracker.Pages.HelpPage"
    Title="{Binding TitleText}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <controls:StravaTopBar TitleText="{Binding TitleText}" />

            <Label Text="{Binding TitleText}" Style="{StaticResource H1}" />
            <Label Text="{Binding SubtitleText}" Style="{StaticResource BodyMuted}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding UrlText}" FontAttributes="Bold" />
                    <Button Text="{Binding OpenHelpText}" Command="{Binding OpenHelpCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Image Source="flag_fr.svg" HeightRequest="20" WidthRequest="30" />
                        <Label Text="{Binding PrivacyTitle}" FontAttributes="Bold" FontSize="18" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding PrivacyIntro}" Style="{StaticResource BodyMuted}" />

                    <Label Text="{Binding PrivacyRetentionTitle}" FontAttributes="Bold" />
                    <Label Text="{Binding PrivacyRetentionBody}" Style="{StaticResource BodyMuted}" />

                    <Label Text="{Binding PrivacySecurityTitle}" FontAttributes="Bold" />
                    <Label Text="{Binding PrivacySecurityBody}" Style="{StaticResource BodyMuted}" />

                    <Label Text="{Binding PrivacyOpenAiTitle}" FontAttributes="Bold" />
                    <Label Text="{Binding PrivacyOpenAiBody}" Style="{StaticResource BodyMuted}" />

                    <Label Text="{Binding PrivacyStorageTitle}" FontAttributes="Bold" />
                    <Label Text="{Binding PrivacyStorageBody}" Style="{StaticResource BodyMuted}" />

                    <Label Text="{Binding CharityTitle}" FontAttributes="Bold" />
                    <Label Text="{Binding CharityBody}" Style="{StaticResource BodyMuted}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
