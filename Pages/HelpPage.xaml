<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutritionTracker.Pages.HelpPage"
    Title="{Binding TitleText}"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="{Binding TitleText}" Style="{StaticResource H1}" />
            <Label Text="{Binding SubtitleText}" Style="{StaticResource BodyMuted}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding UrlText}" FontAttributes="Bold" />
                    <Button Text="{Binding OpenHelpText}" Command="{Binding OpenHelpCommand}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
