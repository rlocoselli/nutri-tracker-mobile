<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:NutritionTracker.Controls"
    x:Class="NutritionTracker.Pages.ProfilePage"
    x:Name="ProfileRoot"
    Title="{Binding ProfileTitle}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <controls:StravaTopBar TitleText="{Binding ProfileTitle}" />

            <Label Text="{Binding ProfileTitle}" Style="{StaticResource H1}" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                    <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32">
                        <Image Source="{Binding PictureUrl}" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" />
                        <Label Text="{Binding Email}" Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding LanguageLabel}" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" />
                    <Label Text="{Binding CurrentLanguageText}" Style="{StaticResource BodyMuted}" />
                    <Label Text="{Binding FitSyncStatusText}" IsVisible="{Binding ShowGoogleFitUi}" FontSize="12" TextColor="{StaticResource Muted}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="False">
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding StepsTodayLabel}" FontAttributes="Bold" FontSize="12" />
                                <Label Text="{Binding TodayStepsText}" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding BurnedCaloriesLabel}" FontAttributes="Bold" FontSize="12" />
                                <Label Text="{Binding TodayBurnText}" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="{Binding AdviceTitle}" FontAttributes="Bold" />
                    <Label Text="{Binding AdviceHint}" Style="{StaticResource BodyMuted}" />
                    <Button Text="{Binding GenerateRecoText}"
                        ImageSource="ic_goals.svg"
                        ContentLayout="Left,10"
                        Command="{Binding OpenRecommendationsCommand}" />

                    <Label Text="{Binding GamificationTitle}" FontAttributes="Bold" Margin="0,10,0,0" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding TotalXpLabel}" FontSize="12" Style="{StaticResource BodyMuted}" />
                                <Label Text="{Binding TotalXp}" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding LevelLabel}" FontSize="12" Style="{StaticResource BodyMuted}" />
                                <Label Text="{Binding PlayerLevel}" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding NextLevelLabel}" FontSize="12" Style="{StaticResource BodyMuted}" />
                                <Label Text="{Binding XpToNextLevel}" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="{Binding GamificationStatusText}" Style="{StaticResource BodyMuted}" />
                    <Label Text="{Binding BadgesTitle}" FontAttributes="Bold" />
                    <CollectionView ItemsSource="{Binding ProfileBadges}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Image Source="{Binding IconSource}" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                                            <Label Text="{Binding Description}" Style="{StaticResource BodyMuted}" />
                                            <Label Text="{Binding ProgressText}" FontSize="12" TextColor="{StaticResource Text}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                            Text="{Binding StateIcon}"
                                            FontSize="18"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="{Binding ReminderTitle}" FontAttributes="Bold" Margin="0,10,0,0" />
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding ReminderEnabledText}" VerticalOptions="Center" />
                        <Switch IsToggled="{Binding RemindersEnabled}" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                        <Label Text="{Binding ReminderBreakfastText}" />
                        <TimePicker Grid.Column="1" Time="{Binding BreakfastReminder}" Format="HH:mm" />

                        <Label Grid.Row="1" Text="{Binding ReminderLunchText}" />
                        <TimePicker Grid.Row="1" Grid.Column="1" Time="{Binding LunchReminder}" Format="HH:mm" />

                        <Label Grid.Row="2" Text="{Binding ReminderDinnerText}" />
                        <TimePicker Grid.Row="2" Grid.Column="1" Time="{Binding DinnerReminder}" Format="HH:mm" />

                        <Label Grid.Row="3" Text="{Binding ReminderSocialEngagementText}" />
                        <TimePicker Grid.Row="3" Grid.Column="1" Time="{Binding SocialEngagementReminder}" Format="HH:mm" />

                        <Label Grid.Row="4" Text="{Binding ReminderNoMealWarningText}" />
                        <TimePicker Grid.Row="4" Grid.Column="1" Time="{Binding NoMealWarningReminder}" Format="HH:mm" />
                    </Grid>

                    <Button Text="{Binding SaveReminderText}"
                        Style="{StaticResource SecondaryButton}"
                        ImageSource="ic_diary.svg"
                        ContentLayout="Left,10"
                        Command="{Binding SaveRemindersCommand}" />
                    <Label Text="{Binding ReminderStatusText}" Style="{StaticResource BodyMuted}" />

                        <Label Text="{Binding StoryVisibilityTitle}" FontAttributes="Bold" Margin="0,10,0,0" />
                        <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding StoryDefaultVisibilityLabel}" Style="{StaticResource BodyMuted}" />
                        <Picker ItemsSource="{Binding StoryVisibilityChoices}"
                            ItemDisplayBinding="{Binding Label}"
                            SelectedItem="{Binding SelectedDefaultStoryVisibility}" />
                        <Button Text="{Binding SaveStoryPrivacyText}"
                            Style="{StaticResource SecondaryButton}"
                            ImageSource="ic_help.svg"
                            ContentLayout="Left,10"
                            Command="{Binding SaveStoryPrivacyCommand}" />
                        <Label Text="{Binding StoryPrivacyStatusText}" Style="{StaticResource BodyMuted}" />
                        </VerticalStackLayout>

                    <Label Text="{Binding FriendsTitle}" FontAttributes="Bold" Margin="0,10,0,0" />
                    <Label Text="{Binding SocialStatusText}" Style="{StaticResource BodyMuted}" />

                    <CollectionView ItemsSource="{Binding Friends}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Label Text="{Binding BadgeText}" FontSize="18" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Email}" FontAttributes="Bold" />
                                            <Label Text="{Binding StatusText}" Style="{StaticResource BodyMuted}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2"
                                                Text="{Binding Source={x:Reference ProfileRoot}, Path=BindingContext.AcceptText}"
                                                IsVisible="{Binding IsPending}"
                                                Style="{StaticResource SecondaryButton}"
                                            ImageSource="ic_add.svg"
                                            ContentLayout="Left,8"
                                                Command="{Binding Source={x:Reference ProfileRoot}, Path=BindingContext.AcceptFriendCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="3"
                                                Text="{Binding Source={x:Reference ProfileRoot}, Path=BindingContext.RemoveText}"
                                                Style="{StaticResource SecondaryButton}"
                                            ImageSource="ic_diary.svg"
                                            ContentLayout="Left,8"
                                                Command="{Binding Source={x:Reference ProfileRoot}, Path=BindingContext.RemoveFriendCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="{Binding FriendsLeagueTitle}" FontAttributes="Bold" Margin="0,6,0,0" />
                    <CollectionView ItemsSource="{Binding FriendRanks}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Label Text="{Binding RankBadge}" FontSize="18" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource BodyMuted}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowSubscriptionUi}">
                            <Label Text="{Binding SubscriptionTitle}" FontAttributes="Bold" Margin="0,10,0,0" />
                            <Label Text="{Binding SubscriptionPlanText}" Style="{StaticResource BodyMuted}" />
                            <Label Text="{Binding SubscriptionStatusText}" Style="{StaticResource BodyMuted}" />
                            <Button Text="{Binding StartFreeTrialText}"
                                Style="{StaticResource SecondaryButton}"
                                ImageSource="ic_add.svg"
                                ContentLayout="Left,10"
                                IsVisible="{Binding CanStartFreeTrial}"
                                Command="{Binding StartFreeTrialCommand}" />
                            <Button Text="{Binding SubscribeGoogleText}"
                                Style="{StaticResource SecondaryButton}"
                                ImageSource="ic_google.svg"
                                ContentLayout="Left,10"
                                IsVisible="{Binding CanSubscribe}"
                                Command="{Binding SubscribeWithGoogleCommand}" />
                            <Button Text="{Binding ConfirmGoogleText}"
                                Style="{StaticResource SecondaryButton}"
                                ImageSource="ic_google.svg"
                                ContentLayout="Left,10"
                                IsVisible="{Binding CanSubscribe}"
                                Command="{Binding ConfirmGoogleSubscriptionCommand}" />
                            </VerticalStackLayout>

                        <Label Text="{Binding AccountSecurityTitle}" FontAttributes="Bold" Margin="0,10,0,0" />
                        <Button Text="{Binding ScoreHistoryButtonText}"
                            Style="{StaticResource SecondaryButton}"
                            ImageSource="ic_stats.svg"
                            ContentLayout="Left,10"
                            Command="{Binding OpenScoreHistoryCommand}" />
                        <Button Text="{Binding PrivacyMenuText}"
                            Style="{StaticResource SecondaryButton}"
                            ImageSource="ic_help.svg"
                            ContentLayout="Left,10"
                            Command="{Binding OpenPrivacyMenuCommand}" />

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEmailAccount}">
                        <Label Text="{Binding CurrentPasswordLabel}" />
                        <Entry Text="{Binding CurrentPassword}" IsPassword="True" />
                        <Label Text="{Binding NewPasswordLabel}" />
                        <Entry Text="{Binding NewPassword}" IsPassword="True" />
                        <Button Text="{Binding ChangePasswordButton}"
                            Style="{StaticResource SecondaryButton}"
                            ImageSource="ic_profile.svg"
                            ContentLayout="Left,10"
                            Command="{Binding ChangePasswordCommand}" />
                        </VerticalStackLayout>

                        <Label Text="{Binding DeleteAccountTitle}" FontAttributes="Bold" Margin="0,6,0,0" />
                        <Label Text="{Binding DeleteAccountHint}" Style="{StaticResource BodyMuted}" />
                        <Entry Text="{Binding DeletePassword}" IsPassword="True" IsVisible="{Binding IsEmailAccount}" Placeholder="{Binding CurrentPasswordLabel}" />
                        <Button Text="{Binding DeleteAccountButton}"
                            Style="{StaticResource SecondaryButton}"
                            ImageSource="ic_diary.svg"
                            ContentLayout="Left,10"
                            Command="{Binding DeleteAccountCommand}" />
                        <Label Text="{Binding AccountActionStatusText}" Style="{StaticResource BodyMuted}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding LogoutText}"
                Style="{StaticResource SecondaryButton}"
                ImageSource="ic_home.svg"
                ContentLayout="Left,10"
                Command="{Binding LogoutCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
