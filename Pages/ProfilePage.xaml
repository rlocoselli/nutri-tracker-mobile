<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutritionTracker.Pages.ProfilePage"
    Title="Profil"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Profil" Style="{StaticResource H1}" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                    <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32">
                        <Image Source="{Binding PictureUrl}" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" />
                        <Label Text="{Binding Email}" Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Conseils" FontAttributes="Bold" />
                    <Label Text="Générez des recommandations basées sur votre historique." Style="{StaticResource BodyMuted}" />
                    <Button Text="Générer des recommandations" Command="{Binding OpenRecommendationsCommand}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Se déconnecter" Style="{StaticResource SecondaryButton}" Command="{Binding LogoutCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
