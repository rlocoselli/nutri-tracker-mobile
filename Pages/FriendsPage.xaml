<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutritionTracker.Pages.FriendsPage"
    x:Name="FriendsRoot"
    Title="{Binding TitleText}"
    BackgroundColor="{StaticResource Background}">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="{Binding TitleText}" Style="{StaticResource H1}" />
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="{Binding TabFriendsText, StringFormat='👥 {0}'}" Style="{StaticResource SecondaryButton}" Command="{Binding ShowFriendsTabCommand}" />
                <Button Grid.Column="1" Text="{Binding TabRequestsText, StringFormat='✉️ {0}'}" Style="{StaticResource SecondaryButton}" Command="{Binding ShowRequestsTabCommand}" />
                <Button Grid.Column="2" Text="{Binding TabSuggestionsText, StringFormat='🔎 {0}'}" IsVisible="{Binding ShowSuggestionsUi}" Style="{StaticResource SecondaryButton}" Command="{Binding ShowSuggestionsTabCommand}" />
            </Grid>

            <Button Text="{Binding ShareAppText, StringFormat='📲 {0}'}" Style="{StaticResource SecondaryButton}" Command="{Binding ShareAppCommand}" />

            <Label Text="{Binding StatusText}" Style="{StaticResource BodyMuted}" />

            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsFriendsTab}">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding InviteSectionTitleText}" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding InviteEmail}" Placeholder="{Binding InvitePlaceholder}" Keyboard="Email" />
                            <Button Grid.Column="1" Text="{Binding InviteText, StringFormat='➕ {0}'}" Style="{StaticResource SecondaryButton}" Command="{Binding InviteCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding FriendsSectionTitleText}" FontAttributes="Bold" />
                        <Entry Text="{Binding FriendsSearchQuery}" Placeholder="{Binding FriendsSearchLocalPlaceholder}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding EmptyFriendsText}" Style="{StaticResource BodyMuted}" IsVisible="False">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasAcceptedFriends}" Value="False">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Text="{Binding EmptyFriendsHelpText}" Style="{StaticResource BodyMuted}" IsVisible="False">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasAcceptedFriends}" Value="False">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <CollectionView ItemsSource="{Binding AcceptedFriends}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Grid WidthRequest="42" HeightRequest="42">
                                            <Border Background="{StaticResource Card2Brush}" StrokeThickness="0" StrokeShape="RoundRectangle 21" IsVisible="{Binding HasPicture}" />
                                            <Image Source="{Binding PictureUrl}" WidthRequest="42" HeightRequest="42" Aspect="AspectFill" IsVisible="{Binding HasPicture}" />
                                            <Border Background="{StaticResource Card2Brush}" StrokeThickness="0" StrokeShape="RoundRectangle 21" IsVisible="{Binding HasNoPicture}" />
                                            <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" IsVisible="{Binding HasNoPicture}" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                            <Label Text="{Binding Handle}" Style="{StaticResource BodyMuted}" />
                                            <Label Text="{Binding Status}" Style="{StaticResource BodyMuted}" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Text="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.ChatText}"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.OpenChatCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1"
                                                Text="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.StoriesText}"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.ViewStoriesCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding LeagueTitleText}" FontAttributes="Bold" Margin="0,6,0,0" />
                <CollectionView ItemsSource="{Binding League}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Label Text="{Binding Rank}" FontSize="18" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding Detail}" Style="{StaticResource BodyMuted}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End">
                                        <Label Text="{Binding TierBadge}" FontSize="18" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding TierName}" Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsRequestsTab}">
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Text="{Binding IncomingSectionText}" VerticalOptions="Center" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="{Binding AcceptAllText}" Style="{StaticResource SecondaryButton}" Command="{Binding AcceptAllIncomingCommand}" />
                        <Button Grid.Column="2" Text="{Binding DeclineAllText}" Style="{StaticResource SecondaryButton}" Command="{Binding DeclineAllIncomingCommand}" />
                    </Grid>
                </Border>

                <CollectionView ItemsSource="{Binding IncomingInvites}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Grid WidthRequest="36" HeightRequest="36">
                                            <Border Background="{StaticResource Card2Brush}" StrokeThickness="0" StrokeShape="RoundRectangle 18" IsVisible="{Binding HasPicture}" />
                                            <Image Source="{Binding PictureUrl}" WidthRequest="36" HeightRequest="36" Aspect="AspectFill" IsVisible="{Binding HasPicture}" />
                                            <Border Background="{StaticResource Card2Brush}" StrokeThickness="0" StrokeShape="RoundRectangle 18" IsVisible="{Binding HasNoPicture}" />
                                            <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" IsVisible="{Binding HasNoPicture}" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding InviterDisplay}" FontAttributes="Bold" />
                                        <Label Text="{Binding InviterHandle}" Style="{StaticResource BodyMuted}" />
                                        <Label Text="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.RequestToConfirmText}" Style="{StaticResource BodyMuted}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Button Grid.Column="1"
                                            Text="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.AcceptText}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.AcceptIncomingCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="2"
                                            Text="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.DeclineText}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.DeclineIncomingCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding OutgoingSectionText}" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding OutgoingInvites}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                        <Label Text="{Binding Handle}" Style="{StaticResource BodyMuted}" />
                                        <Label Text="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.RequestSentStateText}" Style="{StaticResource BodyMuted}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.RemoveText}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.RemoveCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding EmptyRequestsText}" Style="{StaticResource BodyMuted}" IsVisible="False">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasRequestItems}" Value="False">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowSuggestionsUi}">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding SearchSectionTitleText}" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding SearchQuery}" Placeholder="{Binding SearchPlaceholder}" />
                            <Button Grid.Column="1" Text="{Binding SearchText}" Style="{StaticResource SecondaryButton}" Command="{Binding SearchUsersCommand}" />
                        </Grid>
                        <Label Text="{Binding SuggestionsHintText}" Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                </Border>

                <CollectionView ItemsSource="{Binding SearchResults}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Grid WidthRequest="36" HeightRequest="36">
                                            <Border Background="{StaticResource Card2Brush}" StrokeThickness="0" StrokeShape="RoundRectangle 18" IsVisible="{Binding HasPicture}" />
                                            <Image Source="{Binding PictureUrl}" WidthRequest="36" HeightRequest="36" Aspect="AspectFill" IsVisible="{Binding HasPicture}" />
                                            <Border Background="{StaticResource Card2Brush}" StrokeThickness="0" StrokeShape="RoundRectangle 18" IsVisible="{Binding HasNoPicture}" />
                                            <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" IsVisible="{Binding HasNoPicture}" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                        <Label Text="{Binding Handle}" Style="{StaticResource BodyMuted}" />
                                        <Label Text="{Binding NutritionHint}" Style="{StaticResource BodyMuted}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Button Grid.Column="1"
                                            Text="{Binding ActionText}"
                                            Style="{StaticResource SecondaryButton}"
                                            IsVisible="{Binding IsInvitable}"
                                            Command="{Binding Source={x:Reference FriendsRoot}, Path=BindingContext.InviteUserCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Border Grid.Column="1" Style="{StaticResource Card}" IsVisible="{Binding IsInvited}">
                                        <Label Text="{Binding ActionText}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                                    </Border>

                                    <Label Grid.Column="1"
                                           Text="{Binding ActionText}"
                                           FontAttributes="Bold"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsFriend}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding EmptySuggestionsText}" Style="{StaticResource BodyMuted}" IsVisible="False">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasSuggestions}" Value="False">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <Button Text="{Binding RefreshText}" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
        </VerticalStackLayout>
    </ScrollView>

    <Border x:Name="LeagueToast"
            IsVisible="{Binding HasLeagueBadgeAnnouncement}"
            Opacity="0"
            Scale="0.9"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="20,16,20,0"
            Padding="14,10"
            Style="{StaticResource Card}"
            Background="{StaticResource Card2Brush}">
        <Label Text="{Binding LeagueBadgeAnnouncement}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
    </Border>
    </Grid>
</ContentPage>
